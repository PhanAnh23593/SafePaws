# Copy to .env.aws on EC2. Replace every CHANGE_ME value before starting.
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET_BASE64=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
CORS_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_IDS=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_LOGIN
MAIL_PASSWORD=CHANGE_ME_SMTP_KEY
MAIL_FROM=CHANGE_ME_VERIFIED_SENDER
# Only used with --profile https. Domain name only, without https:// or a path.
API_DOMAIN=api.example.com
