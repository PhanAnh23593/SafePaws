# Loaded by Spring Boot when running from the auth-service directory.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/auth_db
DB_USERNAME=safepaws_auth
DB_PASSWORD=
# Generate 32 random bytes, Base64 encoded (see README).
JWT_SECRET_BASE64=
JWT_ACCESS_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
JWT_ISSUER=safepaws-auth
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
# Comma-separated OAuth client IDs accepted as Google ID token audiences.
GOOGLE_CLIENT_IDS=

# Redis must persist auth revocations (AOF, noeviction). Never expose its port publicly.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# SMTP credentials and verified sender from your provider.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
